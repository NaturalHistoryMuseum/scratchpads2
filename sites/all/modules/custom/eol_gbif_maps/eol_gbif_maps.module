<?php

/**
 * Adds the gbif overlay to the gm3 maps.
 *
 * Implements hook_gm3_libraries_alter().
 */
function eol_gbif_maps_gm3_libraries_alter(&$libraries){
  // We add special data to map on taxonomy term pages only.
  if(($term = menu_get_object('taxonomy_term', 2)) != FALSE){
    $gbifId = NULL;

    // Now we need to calculate the GBIF taxon id for this term name, and then
    // add the gbif library to the map.
    // First we check to see if we've loaded this term before, and if so, we
    // use that data.
    $gbifId = db_select('eol_gbif_maps_tid_map', 'e')
      ->fields('e', array('taxon_id'))
      ->condition('tid', $term->tid)
      ->execute()
      ->fetchField();
    if($gbifId === FALSE){
      $gbifId = NULL;
    }
    else{
      $gbifId = (int) $gbifId;
    }

    if(!$gbifId){
      $url = url(
        'https://api.gbif.org/v1/species',
        array('query' => array('name' => $term->name))
      );
      $request = drupal_http_request($url, array(
        'timeout' => 3
      ));
      if(isset($request->code) && $request->code == 200){
        $json = json_decode($request->data, TRUE);
        $gbifId = _eol_gbif_maps_taxon_id_from_response($json);
        if($gbifId){
          db_insert('eol_gbif_maps_tid_map')->fields(array(
            'tid' => $term->tid,
            'taxon_id' => $gbifId
          ))->execute();
        }
      }
      else{
        trigger_error('Request to GBIF species API failed in eol_gbif_maps', E_USER_WARNING);
      }
    }

    // Do not attach an overlay that would generate taxonKey=null requests.
    if($gbifId){
      $libraries['eol_gbif_maps_overlay'] = array(
        'module' => 'eol_gbif_maps',
        'taxon_id' => $gbifId
      );
    }
  }
}

/**
 * Extracts a usable GBIF taxon key from a species search response.
 *
 * GBIF's backbone key (nubKey) is preferred because it aggregates occurrence
 * data across datasets. New or unmatched taxa may only provide a dataset taxon
 * key, which is still accepted by the occurrence map API.
 *
 * @param array|null $response
 *   The decoded response from the GBIF species API.
 *
 * @return int|null
 *   A positive GBIF taxon key, or NULL when no usable match was returned.
 */
function _eol_gbif_maps_taxon_id_from_response($response){
  if(!is_array($response) || empty($response['results'][0]) || !is_array($response['results'][0])){
    return NULL;
  }

  $result = $response['results'][0];
  foreach(array('nubKey', 'key') as $property){
    if(isset($result[$property]) && is_numeric($result[$property]) && (int) $result[$property] > 0){
      return (int) $result[$property];
    }
  }

  return NULL;
}

/**
 * Implementation of hook_taxonomy_term_update().
 */
function eol_gbif_maps_taxonomy_term_update($term){
  db_delete('eol_gbif_maps_tid_map')->condition('tid', $term->tid)->execute();
}

/**
 * Implementation of hook_taxonomy_term_delete($term).
 */
function eol_gbif_maps_taxonomy_term_delete($term){
  eol_gbif_maps_taxonomy_term_update($term);
}

/**
 * Implementation of hook_library().
 */
function eol_gbif_maps_library(){
  return array(
    'eol_gbif_maps_overlay' => array(
      'title' => t('GBIF taxon data overlay'),
      'website' => 'http://eol.org/',
      'version' => '1',
      'js' => array(
        array(
          'data' => drupal_get_path('module', 'eol_gbif_maps') . "/js/eol_gbif_maps.js"
        ),
        array(
          'data' => array(
            'gm3' => array(
              'settings' => array(
                'eol_gbif_maps' => array(
                  'tile_host' => 'https://api.gbif.org'
                )
              )
            )
          ),
          'type' => 'setting'
        )
      ),
      'dependencies' => array(
        array(
          'gm3',
          'gm3'
        )
      )
    )
  );
}
