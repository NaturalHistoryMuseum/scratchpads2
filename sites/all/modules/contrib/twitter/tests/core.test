<?php

/**
 * @file
 * Functional tests for the twitter Module.
 */

class TwitterTest extends DrupalWebTestCase {
  /*'
   * The getInfo() method provides information about the test.
   * In order for the test to be run, the getInfo() method needs
   * to be implemented.
   */
  public static function getInfo() {
    return array(
      'name' => t('Main'),
      'description' => t('Tests main module features such as adding accounts or loading tweets.'),
      'group' => t('Twitter'),
    );
  }

  /**
   * Prepares the testing environment
   */
  function setUp() {
    parent::setUp('twitter', 'views', 'twitter_mock');

    // The non-authenticated account form is available only after the site has
    // API credentials and an authenticated account it can use for lookups.
    variable_set('twitter_consumer_key', 'test-consumer-key');
    variable_set('twitter_consumer_secret', 'test-consumer-secret');
    db_insert('twitter_account')
      ->fields(array(
        'twitter_uid' => 1,
        'screen_name' => 'twitter_mock_auth',
        'name' => 'Twitter mock authenticated account',
        'oauth_token' => 'test-oauth-token',
        'oauth_token_secret' => 'test-oauth-token-secret',
        'created_time' => 0,
        'utc_offset' => 0,
      ))
      ->execute();
  }

  /**
   * Tests account addition without Oauth module activated
   */
  public function testAccountAdditionNoOauth() {
    // Create user
    $this->user = $this->drupalCreateUser(array(
      'add twitter accounts',
    ));
    $this->drupalLogin($this->user);

    // Add a Twitter account
    $edit = array(
      'screen_name' => 'drupal',
    );
    $this->drupalPost('user/' . $this->user->uid . '/edit/twitter',
                      $edit, t('Add a non-authenticated account'));
    $this->assertLink('@drupal', 0,
      t('Twitter account was added successfully'));

    // Load tweets
    twitter_cron();
    $this->drupalGet('tweets/drupal');
    $this->assertText('Update: New maintainers and plans for Drupal 7', 'Tweets were loaded successfully.');
    // Delete the Twitter account
    $edit = array(
      'accounts[0][delete]' => 1,
    );
    $this->drupalPost('user/' . $this->user->uid . '/edit/twitter',
                      $edit, t('Save changes'));
    $this->assertText(t('The Twitter account drupal was deleted.'));
  }
}
